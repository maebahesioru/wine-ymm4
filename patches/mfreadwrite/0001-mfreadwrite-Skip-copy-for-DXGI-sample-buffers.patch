+static BOOL source_reader_sample_has_dxgi_buffer(IMFSample *sample)
+{
+    IMFMediaBuffer *buffer;
+    IMFDXGIBuffer *dxgi_buffer;
+    HRESULT hr;
+
+    if (FAILED(hr = IMFSample_GetBufferByIndex(sample, 0, &buffer)))
+        return FALSE;
+
+    hr = IMFMediaBuffer_QueryInterface(buffer, &IID_IMFDXGIBuffer, (void **)&dxgi_buffer);
+    IMFMediaBuffer_Release(buffer);
+
+    if (FAILED(hr))
+        return FALSE;
+
+    IMFDXGIBuffer_Release(dxgi_buffer);
+    return TRUE;
+}
+
 static struct stream_response *media_stream_pop_response(struct source_reader *reader, struct media_stream *stream)
 {
     struct stream_response *response;
@@ -1253,7 +1272,7 @@ static struct stream_response *media_stream_pop_response(struct source_reader *r
