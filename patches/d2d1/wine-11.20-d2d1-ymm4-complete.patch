+/* YMM4 fix: real Direct2D reports the bounds of an effect output in the
+ * effect's own space, i.e. the transforms applied by the effect chain are
+ * already folded into the result.  Our stub effects are pass-through, so the
+ * bounds of the input are returned unchanged and the application - which uses
+ * these bounds to build its preview hit-test quads - ends up with a rectangle
+ * that is not translated/scaled by the item transform.  Fold the transform of
+ * the common transform effects into the returned bounds. */
+void d2d_effect_apply_matrix_to_bounds(ID2D1Effect *effect, D2D1_RECT_F *bounds)
+{
+    static const CLSID clsid_2daffine = {0x6aa97485,0x6354,0x4cfc,{0x90,0x8c,0xe4,0xa7,0x4f,0x62,0xc9,0x6c}};
+    static const CLSID clsid_3dtransform = {0xe8467b04,0xec61,0x4b8a,{0xb5,0xde,0xd4,0xd7,0x3d,0xeb,0xea,0x5a}};
+    D2D1_MATRIX_3X2_F m;
+    D2D1_MATRIX_4X4_F m4;
+    GUID id;
+    float xs[4], ys[4];
+    int i;
+
+    memset(&id, 0, sizeof(id));
+    if (FAILED(ID2D1Effect_GetValue(effect, D2D1_PROPERTY_CLSID, D2D1_PROPERTY_TYPE_CLSID, (BYTE *)&id, sizeof(id))))
+        return;
+
+    memset(&m, 0, sizeof(m));
+    m._11 = m._22 = 1.0f;
+    if (IsEqualGUID(&id, &clsid_2daffine))
+    {
+        if (FAILED(ID2D1Effect_GetValue(effect, 2 /* TRANSFORM_MATRIX */, D2D1_PROPERTY_TYPE_MATRIX_3X2,
+                (BYTE *)&m, sizeof(m))))
+            return;
+    }
+    else if (IsEqualGUID(&id, &clsid_3dtransform))
+    {
+        memset(&m4, 0, sizeof(m4));
+        if (FAILED(ID2D1Effect_GetValue(effect, 2 /* TRANSFORM_MATRIX */, D2D1_PROPERTY_TYPE_MATRIX_4X4,
+                (BYTE *)&m4, sizeof(m4))))
+            return;
+        m._11 = m4._11; m._12 = m4._12; m._21 = m4._21; m._22 = m4._22;
+        m._31 = m4._41; m._32 = m4._42;
+    }
+    else
+    {
+        return;
+    }
+
+    xs[0] = m._11 * bounds->left  + m._21 * bounds->top    + m._31;
+    ys[0] = m._12 * bounds->left  + m._22 * bounds->top    + m._32;
+    xs[1] = m._11 * bounds->right + m._21 * bounds->top    + m._31;
+    ys[1] = m._12 * bounds->right + m._22 * bounds->top    + m._32;
+    xs[2] = m._11 * bounds->right + m._21 * bounds->bottom + m._31;
+    ys[2] = m._12 * bounds->right + m._22 * bounds->bottom + m._32;
+    xs[3] = m._11 * bounds->left  + m._21 * bounds->bottom + m._31;
+    ys[3] = m._12 * bounds->left  + m._22 * bounds->bottom + m._32;
+
+    bounds->left = bounds->right = xs[0];
+    bounds->top = bounds->bottom = ys[0];
+    for (i = 1; i < 4; ++i)
+    {
+        if (xs[i] < bounds->left) bounds->left = xs[i];
+        if (xs[i] > bounds->right) bounds->right = xs[i];
+        if (ys[i] < bounds->top) bounds->top = ys[i];
+        if (ys[i] > bounds->bottom) bounds->bottom = ys[i];
+    }
+}
