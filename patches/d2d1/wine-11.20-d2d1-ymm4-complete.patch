+/* YMM4 fix: record the bounding box of everything drawn into a command list. */
+static void d2d_command_list_union_point(struct d2d_command_list *command_list, float x, float y)
+{
+    D2D1_MATRIX_3X2_F t = command_list->record_transform;
+    float tx = x * t._11 + y * t._21 + t._31;
+    float ty = x * t._12 + y * t._22 + t._32;
+
+    if (!command_list->bounds_valid)
+    {
+        command_list->bounds.left = command_list->bounds.right = tx;
+        command_list->bounds.top = command_list->bounds.bottom = ty;
+        command_list->bounds_valid = 1;
+        return;
+    }
+
+    if (tx < command_list->bounds.left) command_list->bounds.left = tx;
+    if (tx > command_list->bounds.right) command_list->bounds.right = tx;
+    if (ty < command_list->bounds.top) command_list->bounds.top = ty;
+    if (ty > command_list->bounds.bottom) command_list->bounds.bottom = ty;
+}
+
+static void d2d_command_list_union_rect(struct d2d_command_list *command_list, const D2D1_RECT_F *rect)
+{
+    if (!rect) return;
+    d2d_command_list_union_point(command_list, rect->left, rect->top);
+    d2d_command_list_union_point(command_list, rect->right, rect->top);
+    d2d_command_list_union_point(command_list, rect->right, rect->bottom);
+    d2d_command_list_union_point(command_list, rect->left, rect->bottom);
+}
+
+/* YMM4 fix: best effort size of an arbitrary image (bitmap / command list /
+ * effect chain).  Used to accumulate the bounds of recorded command lists. */
+/* YMM4 fix: compute the local bounds of an image the same way
+ * ID2D1DeviceContext::GetImageLocalBounds() does, so that recorded command list
+ * bounds match what is really drawn.  For an effect output we recurse to input 0
+ * and then fold the effect transform matrix, which is where YMM4 keeps an item's
+ * position; using the plain bitmap size loses that offset and made the preview
+ * hit-test quad (and the selection frame) ignore item movement. */
+static BOOL d2d_command_list_image_bounds(ID2D1Image *image, D2D1_RECT_F *bounds, unsigned int depth)
+{
+    ID2D1Bitmap *bitmap;
+    ID2D1CommandList *command_list;
+    ID2D1Effect *effect;
+    ID2D1Image *input = NULL;
+    D2D_SIZE_F size;
+    BOOL valid = FALSE;
+
+    if (!image || !depth) return FALSE;
+
+    if (SUCCEEDED(ID2D1Image_QueryInterface(image, &IID_ID2D1Bitmap, (void **)&bitmap)))
+    {
+        size = ID2D1Bitmap_GetSize(bitmap);
+        ID2D1Bitmap_Release(bitmap);
+        if (size.width <= 0.0f || size.height <= 0.0f) return FALSE;
+        bounds->left = 0.0f;
+        bounds->top = 0.0f;
+        bounds->right = size.width;
+        bounds->bottom = size.height;
+        return TRUE;
+    }
+
+    if (SUCCEEDED(ID2D1Image_QueryInterface(image, &IID_ID2D1CommandList, (void **)&command_list)))
+    {
+        struct d2d_command_list *command_list_impl = unsafe_impl_from_ID2D1CommandList(command_list);
+        if (command_list_impl && command_list_impl->bounds_valid)
+        {
+            *bounds = command_list_impl->bounds;
+            valid = TRUE;
+        }
+        ID2D1CommandList_Release(command_list);
+        return valid;
+    }
+
+    if (SUCCEEDED(ID2D1Image_QueryInterface(image, &IID_ID2D1Effect, (void **)&effect)))
+    {
+        ID2D1Effect_GetInput(effect, 0, &input);
+        if (input)
+        {
+            valid = d2d_command_list_image_bounds(input, bounds, depth - 1);
+            if (valid) d2d_effect_apply_matrix_to_bounds(effect, bounds);
+            ID2D1Image_Release(input);
+        }
+        ID2D1Effect_Release(effect);
+        return valid;
+    }
+
+    return FALSE;
+}
+
+static void d2d_command_list_union_image(struct d2d_command_list *command_list, ID2D1Image *image,
+        const D2D1_POINT_2F *offset)
+{
+    D2D1_RECT_F rect;
+    float ox = offset ? offset->x : 0.0f;
+    float oy = offset ? offset->y : 0.0f;
+
+    if (!image) return;
+
+    if (!d2d_command_list_image_bounds(image, &rect, 8))
+    {
+        if (getenv("YMM4DIAG")) fprintf(stderr, "YMM4DIAG: union_image SKIP img=%p off=(%.1f,%.1f) unknown-type\n",
+                (void *)image, ox, oy);
+        return;
+    }
+
+    rect.left += ox;
+    rect.right += ox;
+    rect.top += oy;
+    rect.bottom += oy;
+
+    if (getenv("YMM4DIAG")) fprintf(stderr, "YMM4DIAG: union_image img=%p off=(%.1f,%.1f) -> (%g,%g)-(%g,%g)\n",
+            (void *)image, ox, oy, rect.left, rect.top, rect.right, rect.bottom);
+
+    d2d_command_list_union_rect(command_list, &rect);
+}
