+static HRESULT STDMETHODCALLTYPE d2d_command_sink_SetTransform(ID2D1CommandSink *iface, const D2D1_MATRIX_3X2_F *transform)
+{
+    struct d2d_command_sink *sink = impl_from_ID2D1CommandSink(iface);
+
+    if (YMM4DIAG) fprintf(stderr, "YMM4DIAG: (sink)SetTransform in=(%.2f,%.2f,%.2f,%.2f,%.2f,%.2f) replay_valid=%u replay=(%.2f,%.2f)\n",
+            transform->_11, transform->_12, transform->_21, transform->_22, transform->_31, transform->_32,
+            sink->context->replay_offset_valid, sink->context->replay_offset.x, sink->context->replay_offset.y);
+    if (sink->context->replay_offset_valid)
+    {
+        /* YMM4 compatibility: a target offset passed to DrawImage() shifts the
+         * whole replayed command list, including nested lists and any
+         * transforms the list records. */
+        D2D1_MATRIX_3X2_F t = *transform;
+        if (sink->context->effect_matrix_valid)
+        {
+            const D2D1_MATRIX_3X2_F *m = &sink->context->effect_matrix;
+            D2D1_MATRIX_3X2_F r = t;
+            t._11 = m->_11 * r._11 + m->_12 * r._21;
+            t._12 = m->_11 * r._12 + m->_12 * r._22;
+            t._21 = m->_21 * r._11 + m->_22 * r._21;
+            t._22 = m->_21 * r._12 + m->_22 * r._22;
+            t._31 = m->_31 * r._11 + m->_32 * r._21 + r._31;
+            t._32 = m->_31 * r._12 + m->_32 * r._22 + r._32;
+        }
+        t._31 += sink->context->replay_offset.x;
+        t._32 += sink->context->replay_offset.y;
+        ID2D1RenderTarget_SetTransform(SINK_RT(sink), &t);
+    }
+    else
+    {
+        ID2D1RenderTarget_SetTransform(SINK_RT(sink), transform);
+    }
+    return S_OK;
+}
